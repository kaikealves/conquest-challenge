# Personal interview-prep notes, not part of the deliverable
notes/

# Employer-supplied materials: the brief and third-party ledger data.
# Kept locally, never committed. See README for where to place them.
brief/

# Build output and tooling caches
node_modules/
dist/
coverage/
*.tsbuildinfo
playwright-report/
test-results/

# Importer output. Generated from a Provider payload and inheriting its
# confidentiality — anything built from brief/ is a third party's real
# accounting data. The deployed site builds this from the synthetic ledger.
public/data/
