{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "tsBuildInfoFile": "../../node_modules/.tmp/tsconfig.importer.tsbuildinfo",
    "target": "ES2023",
    "lib": ["ES2023"],
    "types": ["node", "vite/client"],
    "resolveJsonModule": true,

    // The importer indexes heavily into account-code maps, where an unchecked
    // lookup is money leaving a Report silently.
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true
  },
  "include": ["."]
}
